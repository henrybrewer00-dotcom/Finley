# Your own Anthropic API key (console.anthropic.com). Max and Team plan API credits apply here.
ANTHROPIC_API_KEY=

# Models (defaults shown)
# FINLEY_WRITER_MODEL=claude-opus-5-5
# FINLEY_WRITER_EFFORT=high
# FINLEY_SCORER_MODEL=claude-haiku-5-5
# FINLEY_RESEARCH_MODEL=claude-haiku-5-5
# FINLEY_JUDGE_MODEL=claude-haiku-5-5
# FINLEY_JUDGE_MIN_SCORE=4
# FINLEY_MAX_REWRITES=2
# FINLEY_SOURCING_MODEL=claude-haiku-5-5
# FINLEY_SEARCHES_PER_QUERY=2

# Sending from your own inbox. For Gmail: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=
FROM_EMAIL=
PHYSICAL_ADDRESS=
DAILY_CAP_PER_INBOX=30

# Optional: treg for email finding (https://treg.to)
# TREG_TOKEN=

# Optional: Hunter, to find emails for companies whose website lists none (free tier: 25/month)
# HUNTER_API_KEY=

# Optional: require a password for the dashboard
# FINLEY_PASSWORD=

# FINLEY_DB=finley.db
