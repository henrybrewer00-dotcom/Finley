# Your own Anthropic API key (console.anthropic.com). Max and Team plan API credits apply here.
ANTHROPIC_API_KEY=

# Models (defaults shown)
# FINLEY_WRITER_MODEL=claude-opus-5-5
# FINLEY_WRITER_EFFORT=high
# FINLEY_SCORER_MODEL=claude-haiku-5-5
# FINLEY_RESEARCH_MODEL=claude-haiku-5-5
# FINLEY_JUDGE_MODEL=claude-haiku-5-5
# FINLEY_JUDGE_MIN_SCORE=4
# FINLEY_MAX_REWRITES=2
# FINLEY_SOURCING_MODEL=claude-haiku-5-5
# FINLEY_SEARCHES_PER_QUERY=2
# FINLEY_SEQUENCE_LENGTH=4
# FINLEY_LEARN_FORMATS=1
# FINLEY_FORMATS_FILE=my_formats.json

# Sending from your own inbox. For Gmail: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=
FROM_EMAIL=
PHYSICAL_ADDRESS=
DAILY_CAP_PER_INBOX=30

# Optional: treg for email finding (https://treg.to)
# TREG_TOKEN=

# Database. Leave unset to use a local SQLite file (FINLEY_DB, default finley.db).
# Set a Postgres URL for hosted installs (Neon's free tier works; on Vercel add it under Storage).
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: Hunter, to find emails for companies whose website lists none (free tier: 25/month)
# HUNTER_API_KEY=

# FINLEY_DB=finley.db

# Encrypts the API keys and SMTP passwords users save in Settings. Required for hosted installs;
# keep it secret and don't change it, or saved keys stop working. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Locally, Finley generates one next to the SQLite file if you leave this unset.
# FINLEY_SECRET_KEY=

# Accounts. "closed" allows only the first sign-up (a private install).
# FINLEY_SIGNUPS=open
